# ============================================================
# AI Organizer - local/manual environment example
# ============================================================
# Copy to .env for local PyCharm or manual Docker testing.
# App Store/AppAPI installs receive NEXTCLOUD_URL and APP_SECRET automatically.

# --------------------
# Nextcloud URL
# --------------------
NEXTCLOUD_URL=http://192.168.1.2:8080

# --------------------
# Standalone PyCharm / CLI authentication
# --------------------
# Needed only when the Python process talks directly to Nextcloud without AppAPI.
# Use a Nextcloud app password, not your normal account password.
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# --------------------
# AppAPI / ExApp authentication
# --------------------
# AppAPI supplies APP_SECRET to a managed ExApp. For manual ExApp testing, set it
# to the secret from the existing AppAPI registration. When APP_SECRET is set,
# NEXTCLOUD_USERNAME/NEXTCLOUD_APP_PASSWORD are not required.
APP_SECRET=
# APP_USER=admin  # Optional local/manual override; normally learned from AppAPI.

# --------------------
# Ollama - optional startup seed
# --------------------
# Leave these blank to use the first-run setup screen.
OLLAMA_URL=
OLLAMA_MODEL=

# --------------------
# Paperless-ngx - optional
# --------------------
PAPERLESS_ENABLED=false
INBOX_PATH=/inbox

# Optional deployment overrides
# APP_ID=ai_organizer
# APP_PERSISTENT_STORAGE=/app/data
# APP_VERSION=0.2.1
# AA_VERSION=4.0.0
# AI_ORGANIZER_CONFIG=./my-local-override.yaml  # Legacy/local override only; not required
# AI_ORGANIZER_IMAGE=darthdragon/ai-organizer:0.2.1
# LOG_LEVEL=INFO
