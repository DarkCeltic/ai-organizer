<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>ai_organizer</id>
    <name>AI Organizer</name>

    <summary>
        Local-AI organization suggestions and one-click apply actions for Nextcloud files.
    </summary>

    <description>
        Analyze a selected Nextcloud file with the existing local Ollama classifier,
        review filename/folder/tag suggestions, and selectively apply them.
        Paperless candidates can be moved to the configured consume folder.
    </description>

    <version>0.2.2</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>darthdragon</author>
    <category>files</category>
    <category>ai</category>
    <category>organization</category>

    <website>https://github.com/DarkCeltic/ai-organizer</website>
    <bugs>https://github.com/DarkCeltic/ai-organizer/issues</bugs>
    <repository>https://github.com/DarkCeltic/ai-organizer</repository>

    <documentation>
        <user>https://github.com/DarkCeltic/ai-organizer#readme</user>
        <admin>https://github.com/DarkCeltic/ai-organizer#readme</admin>
        <developer>https://github.com/DarkCeltic/ai-organizer</developer>
    </documentation>

    <dependencies>
        <nextcloud min-version="33" max-version="34"/>
    </dependencies>

    <external-app>
        <docker-install>
            <registry>docker.io</registry>
            <image>darthdragon/ai-organizer</image>
            <image-tag>0.2.2</image-tag>
        </docker-install>

        <environment-variables>

            <variable>
                <name>OLLAMA_URL</name>
                <display-name>Ollama URL</display-name>
                <description>Optional initial Ollama URL. It can also be configured after installation in AI Organizer Settings.</description>
                <default></default>
            </variable>

            <variable>
                <name>OLLAMA_MODEL</name>
                <display-name>Ollama Model</display-name>
                <description>Optional initial Ollama model. It can also be configured after installation in AI Organizer Settings.</description>
                <default></default>
            </variable>

            <variable>
                <name>PAPERLESS_ENABLED</name>
                <display-name>Enable Paperless-ngx</display-name>
                <description>Enable optional Paperless-ngx integration</description>
                <default>false</default>
            </variable>

            <variable>
                <name>INBOX_PATH</name>
                <display-name>Paperless Inbox Path</display-name>
                <description>
                    Optional Nextcloud folder used for Paperless-ngx documents.
                    The default is /inbox.
                </description>
                <default>/inbox</default>
            </variable>
        </environment-variables>

        <routes>
            <!--
                Nextcloud loads registered Top Menu CSS/JS through the AppAPI proxy.
                Static assets contain no credentials or user data and must be reachable
                without an ADMIN route check, otherwise AppAPI may return an HTML error
                page for app.css/app.js and the embedded UI renders blank.
            -->
            <route>
                <url>^/static/.*$</url>
                <verb>GET</verb>
                <access_level>PUBLIC</access_level>
                <headers_to_exclude>[]</headers_to_exclude>
                <bruteforce_protection>[]</bruteforce_protection>
            </route>

            <route>
                <url>^/api/settings(?:/.*)?$</url>
                <verb>GET,POST,PUT</verb>
                <access_level>ADMIN</access_level>
                <headers_to_exclude>[]</headers_to_exclude>
                <bruteforce_protection>[401,429]</bruteforce_protection>
            </route>

            <route>
                <url>^(?!/static/)(?!/api/settings(?:/|$)).*</url>
                <verb>GET,POST,PUT,DELETE</verb>
                <access_level>ADMIN</access_level>
                <headers_to_exclude>[]</headers_to_exclude>
                <bruteforce_protection>[401,403,500]</bruteforce_protection>
            </route>
        </routes>
    </external-app>
</info>